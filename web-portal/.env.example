# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ขึ้น GitHub)

# รหัสผ่านฐานข้อมูล ใช้ตัวอักษรภาษาอังกฤษกับตัวเลขเท่านั้น
POSTGRES_PASSWORD=change-me

# อีเมลที่เลือกบทบาทครูได้ คั่นด้วยจุลภาค เช่น a@x.ac.th,b@x.ac.th
TEACHER_EMAILS=

# ล็อกอินทดสอบ: true เฉพาะตอนพัฒนาบนเครื่องตัวเอง ห้ามเปิดบนเซิร์ฟเวอร์จริง
DEV_LOGIN=true

# true เมื่อเว็บอยู่หลัง HTTPS (เซิร์ฟเวอร์จริง)
COOKIE_SECURE=false

# พอร์ตที่เปิดเว็บ เช่น http://localhost:8080
HTTP_PORT=8080

# เวอร์ชันของ Net-Desktop ที่ใช้ (ชื่อ branch, tag หรือ commit)
SIM_REF=main
# รหัสผ่านหน้าครูของ Net-Desktop
SIM_TEACHER_PASSWORD=teacher1234
