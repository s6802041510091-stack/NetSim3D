[gd_resource type="Resource" script_class="Mission06Data" load_steps=8 format=3]

[ext_resource type="Script" path="res://missions/mission_06/scripts/mission_06_data.gd" id="1_data"]
[ext_resource type="Script" path="res://missions/mission_06/scripts/mission_06_question.gd" id="2_question"]

[sub_resource type="Resource" id="q_program"]
script = ExtResource("2_question")
question_id = "program"
where = "call"
prompt = "คุณ|จะเชื่อมต่อเข้าไปแก้จากที่นี่ ถามครูว่าเครื่องนั้น**มีโปรแกรมอะไร**"
options = PackedStringArray("เครื่องนั้นมีโปรแกรม TeamViewer ไหมครับ", "เครื่องนั้นมีโปรแกรม TeamSpeak ไหมครับ", "เครื่องนั้นมีโปรแกรม Adobe After Effects ไหมครับ", "เครื่องนั้นมีโปรแกรม Adobe Express ไหมครับ")
correct_index = 0
reactions = PackedStringArray("ครูสาว|มีอยู่ค่ะ ไอคอนอยู่บน Desktop เลย", "ครูสาว|TeamSpeak เหรอคะ อันนั้นไว้คุยเสียงไม่ใช่เหรอคะ ในเครื่องห้องประชุมไม่มีนะคะ", "ครูสาว|เอ๊ะ โปรแกรมนั้นไว้ทำเอฟเฟกต์วิดีโอไม่ใช่เหรอคะ มันต่อเครื่องให้ได้ด้วยเหรอคะ", "ครูสาว|อันนั้นครูใช้ทำโปสเตอร์นะคะ มันต่อเครื่องให้ได้ด้วยเหรอคะ")

[sub_resource type="Resource" id="q_request"]
script = ExtResource("2_question")
question_id = "request"
where = "call"
prompt = "คุณ|จะ**ขอข้อมูลอะไรจากครู**เพื่อเชื่อมต่อเข้าเครื่อง"
options = PackedStringArray("รบกวนครูส่ง Your ID กับ Password ที่ขึ้นในหน้าต่าง TeamViewer มาทางอีเมลครับ", "รบกวนครูส่ง IP Address ของเครื่องห้องประชุมมาให้ทางอีเมลได้ไหมครับ", "รบกวนครูส่งชื่อผู้ใช้กับรหัสผ่าน Windows ของครูมาทางอีเมลได้ไหมครับ", "ครูปิดเครื่องรอไว้ก่อนเลยครับ เดี๋ยวผมจัดการให้เองจากที่นี่ครับ")
correct_index = 0
reactions = PackedStringArray("ครูสาว|ได้ค่ะ เดี๋ยวส่งไปให้นะคะ", "ครูสาว|IP Address คืออะไรคะ ครูไม่รู้จะดูตรงไหนเลย ในหน้าต่าง TeamViewer ก็ไม่เห็นมีนะคะ", "ครูสาว|รหัสเข้าเครื่องของครูเลยเหรอคะ ครูไม่อยากให้ใครรู้นะคะ มีวิธีอื่นไหมคะ", "ครูสาว|ถ้าปิดเครื่องไปแล้ว คุณจะเข้ามาแก้ได้ยังไงคะ")

[sub_resource type="Resource" id="q_keep_open"]
script = ExtResource("2_question")
question_id = "keep_open"
where = "call"
prompt = "ครูสาว|แล้วระหว่างรอ ครู**ปิดหน้าต่าง TeamViewer** ไปก่อนได้ไหมคะ มันบังสไลด์"
options = PackedStringArray("ย่อหน้าต่างได้ครับ แต่อย่าปิดโปรแกรม ไม่งั้นผมเชื่อมต่อไม่ได้", "ปิดได้เลยครับ ผมเชื่อมต่อเข้าไปได้แม้ไม่ได้เปิดโปรแกรมไว้", "ปิดได้ครับ แล้วถอดสายแลนออกด้วยจะได้ไม่มีใครเข้าเครื่องได้", "ปิดเครื่องไปก่อนเลยครับ เดี๋ยวผมเปิดเครื่องให้เองจากที่นี่")
correct_index = 0
reactions = PackedStringArray("ครูสาว|ได้ค่ะ ยังพอมีเวลาอยู่ ฝากด้วยนะคะ", "ครูสาว|จริงเหรอคะ งั้นทำไมเมื่อกี้ต้องให้ครูเปิดโปรแกรมด้วยล่ะคะ", "ครูสาว|ถ้าถอดสายแลน คุณก็เข้ามาไม่ได้ด้วยสิคะ", "ครูสาว|ปิดเครื่องแล้ว คุณจะเปิดจากตรงนั้นได้ด้วยเหรอคะ")

[sub_resource type="Resource" id="q_limits"]
script = ExtResource("2_question")
question_id = "limits"
where = "chat"
prompt = "ถามหน่อยค่ะ ถ้าวันหลังลำโพงพังจริง ๆ คุณแก้จากตรงนั้นได้ไหมคะ"
options = PackedStringArray("ไม่ได้ครับ แก้ระยะไกลได้แค่ซอฟต์แวร์ อุปกรณ์เสียต้องไปดูที่เครื่อง", "ได้ครับ TeamViewer ซ่อมลำโพงที่พังได้จากระยะไกล ไม่ต้องไปที่เครื่องครับ", "ได้ครับ แค่ติดตั้งโปรแกรมเพิ่ม ลำโพงที่พังก็กลับมาใช้ได้เองครับ", "ไม่ได้ครับ TeamViewer ใช้ได้แค่ส่งข้อความหากัน ควบคุมเครื่องไม่ได้ครับ")
correct_index = 0
reactions = PackedStringArray("เข้าใจแล้วค่ะ", "ซ่อมของที่พังได้ด้วยเหรอคะ ครูว่าไม่น่าใช่นะคะ", "ลำโพงพังแล้วลงโปรแกรมก็หายเหรอคะ ฟังดูแปลก ๆ นะคะ", "แต่เมื่อกี้คุณก็เข้ามาปรับเสียงให้ได้นี่คะ")

[sub_resource type="Resource" id="q_password"]
script = ExtResource("2_question")
question_id = "password"
where = "chat"
prompt = "อีกอย่างค่ะ ปิด TeamViewer แล้ว รหัสที่ครูส่งไปยังใช้เข้าเครื่องได้อีกไหมคะ"
options = PackedStringArray("ไม่ได้แล้วครับ Password จะเปลี่ยนใหม่ทุกครั้งที่เปิดโปรแกรมครับ", "ได้ตลอดครับ ครูเก็บรหัสนี้ไว้ใช้กับครั้งหน้าได้เลยครับ", "ได้ครับ แต่ต้องรู้ IP Address ของเครื่องห้องประชุมด้วยถึงจะเข้าได้", "ไม่ได้ครับ เพราะ TeamViewer จะลบตัวเองทิ้งหลังใช้งานครับ")
correct_index = 0
reactions = PackedStringArray("ดีเลยค่ะ ขอบคุณมากนะคะ ครูต้องขึ้นนำเสนอแล้วค่ะ", "ถ้าใช้ได้ตลอด ใครได้อีเมลนี้ไปก็เข้าเครื่องได้สิคะ น่ากลัวนะคะ", "เมื่อกี้ไม่เห็นต้องใช้ IP Address เลยนี่คะ", "ลบตัวเองเลยเหรอคะ แต่ไอคอนยังอยู่บน Desktop นะคะ")

[resource]
script = ExtResource("1_data")
call_lines = PackedStringArray("คุณ|ฝ่าย IT Support สวัสดีครับ", "ครูสาว|(พูดเสียงเบา) สวัสดีค่ะ ครูอยู่ใน**ห้องประชุมเล็ก** กำลัง**ประชุมกลุ่มสาระฯ** อีกสักครู่ต้อง**เปิดคลิปวิดีโอนำเสนอ** แต่เปิดแล้ว**ไม่มีเสียงเลย**ค่ะ", "คุณ|เป็นแค่คลิปนี้ หรือเปิดอะไรก็ไม่มีเสียงครับ ลำโพงยังเสียบอยู่ไหมครับ", "ครูสาว|ลองเปิดเพลงก็เงียบค่ะ สายลำโพงเสียบอยู่ ไฟก็ติดค่ะ ประชุมอยู่แบบนี้ คุณคงเข้ามาดูให้ไม่ได้ **ทำยังไงดีคะ**")
call_lines_after_request = PackedStringArray("คุณ|ผมขออนุญาตเชื่อมต่อเข้าไปแก้จากที่นี่ จะได้ไม่ต้องรบกวนที่ประชุมนะครับ ระหว่างที่ผมเชื่อมต่อ ครูจะเห็นเมาส์ขยับเองบนหน้าจอ ครูไม่ต้องจับเมาส์นะครับ แก้เสร็จแล้วผมจะพิมพ์บอกในแชทของ TeamViewer ให้ครูลองเปิดคลิปฟังเสียง**ก่อนขึ้นนำเสนอ**ครับ")
questions = Array[ExtResource("2_question")]([SubResource("q_program"), SubResource("q_request"), SubResource("q_keep_open"), SubResource("q_limits"), SubResource("q_password")])
mail_body = "รบกวนด้วยนะคะ

Your ID:   {id}
Password:  {password}"
mail_body_after_restart = "เครื่องดับไปแล้วเปิดขึ้นมาใหม่ค่ะ ครูเปิด TeamViewer ใหม่แล้ว รหัสเปลี่ยนแล้วนะคะ

Your ID:   {id}
Password:  {password}"
knowledge_rows = PackedStringArray("TeamViewer|เปิดโปรแกรมทั้งสองเครื่อง ผู้ใช้ปลายทางแจ้ง ID และ Password (Password เปลี่ยนทุกครั้งที่เปิดโปรแกรมใหม่)", "AnyDesk|เปิดโปรแกรมทั้งสองเครื่อง ผู้ใช้ปลายทางแจ้ง AnyDesk Address แล้วกด Accept ให้เชื่อมต่อ", "ซอฟต์แวร์ควบคุมระยะไกล|ใช้มองเห็นและควบคุม Desktop ปลายทาง แก้ได้เฉพาะด้านซอฟต์แวร์ ต้องได้รับอนุญาตจากผู้ใช้ และไม่เปิดไฟล์ส่วนตัวของผู้ใช้")
