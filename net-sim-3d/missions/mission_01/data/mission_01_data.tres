plan_position = Vector2(730, 68)

[sub_resource type="Resource" id="Resource_a0xh8"]
script = ExtResource("1_vd6ra")
point_id = 3
title = "จุดให้บริการเครือข่ายไร้สาย"
location = "จุดติดตั้งบนเพดานกลางห้องคอมพิวเตอร์"
question = "เลือกอุปกรณ์สำหรับให้บริการเครือข่ายไร้สายภายในห้องคอมพิวเตอร์"
options = PackedStringArray("Router", "Wireless Access Point")
correct_option = "Wireless Access Point"
hint = "จุดนี้รับสาย LAN จากอุปกรณ์ศูนย์กลาง แล้วให้บริการอุปกรณ์พกพาภายในห้องเดียวกัน"
plan_position = Vector2(385, 410)

[resource]
script = ExtResource("2_ernc7")
brief = "ฝ่าย IT ได้รับมอบหมายให้วางแผนเครือข่ายของห้องปฏิบัติการคอมพิวเตอร์

ผังห้อง โต๊ะ Wall Rack 9U จุดติดตั้ง และเส้นทางสาย LAN ถูกกำหนดไว้เรียบร้อยแล้ว งานของคุณคือเลือกอุปกรณ์เครือข่ายที่เหมาะสมให้ครบทั้ง 3 จุดบนผังห้อง

จุดที่ 1  การเชื่อมต่อเครือข่ายภายนอก (30 คะแนน)
จุดที่ 2  อุปกรณ์ศูนย์กลางภายใน Wall Rack (40 คะแนน)
จุดที่ 3  จุดให้บริการเครือข่ายไร้สาย (30 คะแนน)

คะแนนเต็ม 100 คะแนน เมื่อกด \"ตรวจสอบแบบ\" จุดที่ผิดจะถูกหักจุดละ 5 คะแนน และถูกหักซ้ำทุกครั้งที่ตรวจหากยังผิดอยู่ เปลี่ยนคำตอบก่อนกดตรวจไม่เสียคะแนน"
requirements = PackedStringArray("ห้องคอมพิวเตอร์มีคอมพิวเตอร์ครู 1 เครื่อง และคอมพิวเตอร์นักเรียน 20 เครื่อง (โต๊ะนักเรียน 10 ตัว ตัวละ 2 เครื่อง) รวม 21 เครื่อง", "คอมพิวเตอร์ทุกเครื่องต้องใช้งานเครือข่ายภายในห้อง และเชื่อมต่อออกสู่เครือข่ายภายนอกได้", "อุปกรณ์ศูนย์กลางของห้องติดตั้งใน Wall Rack 9U ซึ่งอยู่หลังโต๊ะครู", "ภายในห้องต้องมีจุดให้บริการเครือข่ายไร้สายสำหรับอุปกรณ์พกพา", "ผังห้อง ตำแหน่งโต๊ะ Wall Rack จุดติดตั้ง และเส้นทางสาย LAN ถูกกำหนดไว้แล้ว ลาก ย้าย ลบ หรือแก้ไขไม่ได้", "เลือกอุปกรณ์ให้ครบทั้ง 3 จุด แล้วกด \"ตรวจสอบแบบ\" เพื่อตรวจทั้ง 3 จุดพร้อมกัน")
questions = Array[ExtResource("1_vd6ra")]([SubResource("Resource_wbdih"), SubResource("Resource_g2eff"), SubResource("Resource_a0xh8")])
