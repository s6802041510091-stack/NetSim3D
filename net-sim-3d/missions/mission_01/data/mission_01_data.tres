[sub_resource type="Resource" id="Resource_wbdih"]
script = ExtResource("1_vd6ra")
title = "การเชื่อมต่อเครือข่ายภายนอก"
location = "ระหว่างเครือข่ายภายนอกกับเครือข่ายภายใน"
question = "เลือกอุปกรณ์สำหรับเชื่อมต่อเครือข่ายภายนอกกับเครือข่ายภายใน"
options = PackedStringArray("Router", "Wireless Access Point", "Switched Hub 24 Port", "Repeater")
correct_option = "Router"
hint = "พิจารณาว่าอุปกรณ์ใดทำหน้าที่เชื่อมต่อเครือข่ายต่างวงเข้าด้วยกัน"
plan_position = Vector2(860, 150)

[sub_resource type="Resource" id="Resource_g2eff"]
script = ExtResource("1_vd6ra")
point_id = 2
title = "อุปกรณ์ศูนย์กลางภายใน Wall Rack"
location = "ภายใน Wall Rack 9U หลังโต๊ะครู"
question = "เลือกอุปกรณ์ศูนย์กลางสำหรับคอมพิวเตอร์ครูและคอมพิวเตอร์นักเรียนรวม 21 เครื่อง"
options = PackedStringArray("Switched Hub 24 Port", "Shared Hub 24 Port", "Switched Hub 16 Port", "Switched Hub 8 Port")
correct_option = "Switched Hub 24 Port"
hint = "คอมพิวเตอร์ 21 เครื่องใช้งานพร้อมกัน อย่าลืมนับพอร์ตที่ต้องต่อไปยังอุปกรณ์จุดอื่นด้วย"
plan_position = Vector2(730, 68)

[sub_resource type="Resource" id="Resource_a0xh8"]
script = ExtResource("1_vd6ra")
point_id = 3
title = "จุดให้บริการเครือข่ายไร้สาย"
location = "จุดติดตั้งบนเพดานกลางห้องคอมพิวเตอร์"
question = "เลือกอุปกรณ์สำหรับให้บริการเครือข่ายไร้สายภายในห้องคอมพิวเตอร์"
options = PackedStringArray("Wireless Access Point", "Router", "Switched Hub 8 Port", "Bridge")
correct_option = "Wireless Access Point"
hint = "จุดนี้รับสาย LAN จากอุปกรณ์ศูนย์กลาง แล้วให้บริการอุปกรณ์พกพาภายในห้องเดียวกัน"
plan_position = Vector2(385, 410)

[resource]
script = ExtResource("2_ernc7")
brief = "ฝ่าย IT ได้รับมอบหมายให้วางแผนเครือข่ายของห้องปฏิบัติการคอมพิวเตอร์

ผังห้อง โต๊ะ Wall Rack 9U จุดติดตั้ง และเส้นทางสาย LAN ถูกกำหนดไว้เรียบร้อยแล้ว งานของคุณคือเลือกอุปกรณ์เครือข่ายที่เหมาะสมให้ครบทั้ง 3 จุดบนผังห้อง

จุดที่ 1  การเชื่อมต่อเครือข่ายภายนอก
จุดที่ 2  อุปกรณ์ศูนย์กลางภายใน Wall Rack
จุดที่ 3  จุดให้บริการเครือข่ายไร้สาย

แต่ละจุดมีอุปกรณ์ให้เลือก 4 ชนิด คลิกรูปอุปกรณ์ที่ต้องการ แล้วตอบว่าเลือกอุปกรณ์นั้นเพราะอะไร

คะแนนเต็ม 100 = ความถูกต้องของผลงาน 30 + กระบวนการทำงาน (อุปกรณ์และเหตุผล) 50 + ประสิทธิภาพด้านเวลา 20
เมื่อกด \"ตรวจสอบแบบ\" จุดที่ผิดจะถูกหักคะแนนความถูกต้อง ระบบนับเหตุผลครั้งแรกที่ยืนยันของแต่ละอุปกรณ์"
requirements = PackedStringArray("ห้องคอมพิวเตอร์มีคอมพิวเตอร์ครู 1 เครื่อง และคอมพิวเตอร์นักเรียน 20 เครื่อง (โต๊ะนักเรียน 10 ตัว ตัวละ 2 เครื่อง) รวม 21 เครื่อง", "คอมพิวเตอร์ทุกเครื่องเชื่อมต่อด้วยสาย LAN เข้ากับอุปกรณ์ศูนย์กลาง และต้องเชื่อมต่อออกสู่เครือข่ายภายนอกได้", "อุปกรณ์ศูนย์กลางของห้องติดตั้งใน Wall Rack 9U ซึ่งอยู่หลังโต๊ะครู และต้องเหลือพอร์ตสำหรับต่อไปยังอุปกรณ์จุดอื่น", "ภายในห้องต้องมีจุดให้บริการเครือข่ายไร้สายสำหรับอุปกรณ์พกพา", "ผังห้อง ตำแหน่งโต๊ะ Wall Rack จุดติดตั้ง และเส้นทางสาย LAN ถูกกำหนดไว้แล้ว ลาก ย้าย ลบ หรือแก้ไขไม่ได้", "แต่ละจุดต้องเลือกอุปกรณ์ 1 ชนิดพร้อมเหตุผล แล้วกด \"ตรวจสอบแบบ\" เพื่อตรวจทั้ง 3 จุดพร้อมกัน")
questions = Array[ExtResource("1_vd6ra")]([SubResource("Resource_wbdih"), SubResource("Resource_g2eff"), SubResource("Resource_a0xh8")])
