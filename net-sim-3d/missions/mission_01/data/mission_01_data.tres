question = "เลือกอุปกรณ์ศูนย์กลางสำหรับคอมพิวเตอร์ครูและคอมพิวเตอร์นักเรียนรวม 21 เครื่อง"
options = PackedStringArray("Switched Hub 24 Port", "Shared Hub 24 Port")
correct_option = "Switched Hub 24 Port"
max_score = 40
